// Dessicant dehumidifier enable command
DessicantDehumidifierCmd : BoolPoint { dessicantDehumidifier }

// Temperature conditioning mode for a zone in an HVAC system
ZoneAirHvacModeSp : EnumPoint & SpPoint { zone, air, hvacMode }

// Point associated with the on/off state of equipment
RunPoint : BoolPoint <abstract> {
  run
  enum: Obj <val:RunEnum>
}

// On and off enumeration
RunEnum: Enum { off, on }

// Sensor for on/off state of equipment
RunSensor : RunPoint & SensorPoint

// Sensor for on/off state of cooling equipment
CoolRunSensor : RunSensor {
  cool
  stage: Int?
}

// Sensor for on/off state of heating equipment
HeatRunSensor : RunSensor {
  heat
  stage: Int?
}

// On/off command to run equipment
RunCmd : RunPoint & CmdPoint

// On/off command to run cooling equipment
CoolRunCmd : RunCmd {
  cool
  stage: Int?
}

// On/off command to run heating equipment
HeatRunCmd : RunCmd {
  heat
  stage: Int?
}

// Point that enables or disables equipment
EnablePoint : BoolPoint <abstract> {
  enable
  enum: Obj <val:RunEnum>
}

// Command to permit/prohibit equipment to run.
// Used as an interlock with a run command.
EnableCmd : EnablePoint & CmdPoint

// Command to permit/prohibit cooling equipment to run.
// Used as an interlock with a run command.
CoolEnableCmd : EnableCmd {
  cool
  stage: Int?
}

// Command to permit/prohibit heating equipment to run.
// Used as an interlock with a run command.
HeatEnableCmd : EnableCmd {
  heat
  stage: Int?
}

// Boolean alarm condition
AlarmSensor : BoolPoint & SensorPoint <abstract> { alarm }

// Point with variable output from 0% to 100%.
ModulatingPoint : NumberPoint <abstract> {
  modulating
  unit: Unit <invariant> "%"
}

// Sensor for the capacity at which equipment is operating as a
// percentage from 0% to 100%. See [ph.doc::PointPatterns] chapter.
ModulatingSensor : ModulatingPoint & SensorPoint <abstract>

// Command for equipment to operate at a percentage of capacity from
// 0% to 100%. See [ph.doc::PointPatterns] chapter.
ModulatingCmd : ModulatingPoint & CmdPoint <abstract>

// Sensor for modulating cooling capacity as a percentage from 0% to 100%.
CoolModulatingSensor : ModulatingSensor {
  cool
  stage: Int?
}

// Command for modulating cooling capacity as a percentage from 0% to 100%.
CoolModulatingCmd : ModulatingCmd {
  cool
  stage: Int?
}

// Sensor for modulating heating capacity as a percentage from 0% to 100%.
HeatModulatingSensor : ModulatingSensor {
  heat
  stage: Int?
}

// Command for modulating heating capacity as a percentage from 0% to 100%.
HeatModulatingCmd : ModulatingCmd {
  heat
  stage: Int?
}

// Sensor for equipment runtime
RuntimeSensor : NumberPoint & SensorPoint {
  runtime
  unit: Unit <quantity:"time"> "hr"
}

// Setpoint for a limit that constrains the range a value is kept
// within.  Limits are absolute bounds with no deadband, unlike a
// [ph.points::TargetSp] that tolerates deviation from the target
// within a deadband.  See [ph.doc::PointPatterns] chapter.
LimitSp : SpPoint <abstract>

// Setpoint for the lower limit that a control system keeps a value
// at or above, such as the minimum airflow of a VAV.  Limits are
// absolute bounds with no deadband, unlike a [ph.points::TargetSp]
// that tolerates deviation from the target within a deadband.
// See [ph.doc::PointPatterns] chapter.
MinSp : LimitSp <abstract>

// Setpoint for the upper limit that a control system keeps a value
// at or below, such as an electrical demand limit.  Limits are
// absolute bounds with no deadband, unlike a [ph.points::TargetSp]
// that tolerates deviation from the target within a deadband.
// See [ph.doc::PointPatterns] chapter.
MaxSp : LimitSp <abstract>

// Direction from which control drives a value toward a target
// setpoint.  See [ph.doc::PointPatterns] chapter.
TargetSpType: Enum {
  twoSided       // control drives the value toward the setpoint from both directions
  oneSidedLower  // control drives the value up toward the setpoint; it may float above
  oneSidedUpper  // control drives the value down toward the setpoint; it may float below
}

// Setpoint for the target that control drives a value toward, from
// both directions or only one as specified by its spTargetType.
// Deviation from the target is tolerated within a deadband, unlike
// a [ph.points::LimitSp] that bounds a value absolutely with no
// deadband.  See [ph.doc::PointPatterns] chapter.
TargetSp : SpPoint <abstract> {
  targetSpType: TargetSpType
}

// Setpoint the control loop may use while its conditions are met,
// such as occupancy, heating/cooling mode, or a demand response
// event.  Control drives the value toward it from both directions
// or only one as specified by its spTargetType.  Deviation from
// the target is tolerated within a deadband, unlike a
// [ph.points::LimitSp] that bounds a value absolutely with no
// deadband.  See [ph.doc::PointPatterns] chapter.
CandidateSp : TargetSp <abstract>

// Setpoint the control loop is currently using, resolving the
// conditions in effect when the same value has multiple candidate
// setpoints.  Control drives the value toward it from both
// directions or only one as specified by its spTargetType.
// Deviation from the target is tolerated within a deadband, unlike
// a [ph.points::LimitSp] that bounds a value absolutely with no
// deadband.  See [ph.doc::PointPatterns] chapter.
EffectiveSp : TargetSp <abstract> { effective }
