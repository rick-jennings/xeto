// Point associated with a temperature deadband, the range around a
// target setpoint in which no output change is made
TempDeadbandPoint : NumberPoint <abstract> {
  temp
  deadband
  pointQuantity: Temp
  unit: Unit <quantity:"temperatureDifferential"> "Δ°F"
}

// Setpoint for a temperature deadband
TempDeadbandSp : TempDeadbandPoint & SpPoint
