//////////////////////////////////////////////////////////////////////////
// Flow
//////////////////////////////////////////////////////////////////////////

// Sensor for mass flow of refrigerant
RefrigMassFlowSensor : FluidMassFlowSensor {
  refrig
  unit: Unit "lb/min"
}

// Setpoint for mass flow of refrigerant
RefrigMassFlowSp : FluidMassFlowSp {
  refrig
  unit: Unit "lb/min"
}

//////////////////////////////////////////////////////////////////////////
// Pressure
//////////////////////////////////////////////////////////////////////////

// Sensor for refrigerant pressure
RefrigPressureSensor : FluidPressureSensor {
  refrig
  unit: Unit "psi"
}

// Setpoint for refrigerant pressure
RefrigPressureSp : FluidPressureSp {
  refrig
  unit: Unit "psi"
}

//////////////////////////////////////////////////////////////////////////
// Temp
//////////////////////////////////////////////////////////////////////////

// Sensor for refrigerant temperature
RefrigTempSensor : FluidTempSensor { refrig }

// Setpoint for refrigerant temperature
RefrigTempSp : FluidTempSp { refrig }
